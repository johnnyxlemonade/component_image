{
  "name": "lemonade/component_image",
  "description": "Lemonade image component for PHP 8.1+ with GD-based resizing, cropping, cache generation and WebP support.",
  "type": "library",
  "keywords": [
    "php",
    "php-8.1",
    "image",
    "gd",
    "resize",
    "crop",
    "webp",
    "cache",
    "lemonade",
    "lemonade-framework"
  ],
  "homepage": "https://lemonadeframework.cz/",
  "readme": "README.md",
  "license": "MIT",
  "authors": [
    {
      "name": "Honza Mudrak",
      "email": "honzamudrak@gmail.com",
      "homepage": "https://lemonadeframework.cz/"
    }
  ],
  "require": {
    "php": ">=8.1",
    "ext-gd": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Lemonade\\Image\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Lemonade\\Image\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true,
    "classmap-authoritative": false,
    "preferred-install": {
      "*": "dist"
    },
    "notify-on-install": false,
    "process-timeout": 0,
    "platform": {
      "php": "8.1.28"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php -r \"echo 'Autoload refreshed'.PHP_EOL;\""
    ],
    "lint": [
      "@php tools/lint.php"
    ],
    "smoke": [
      "@php tools/smoke.php"
    ],
    "autoload:dev": [
      "@composer dump-autoload"
    ],
    "autoload:optimize": [
      "@composer dump-autoload --optimize"
    ],
    "autoload:prod": [
      "@composer dump-autoload --optimize --classmap-authoritative"
    ],
    "composer:validate": [
      "@composer validate --strict"
    ],
    "stan": [
      "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=16G"
    ],
    "stan:ci": [
      "@php vendor/bin/phpstan analyse -c phpstan.neon.dist --no-progress --error-format=github --memory-limit=1G"
    ],
    "cs:check": [
      "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --allow-risky=yes"
    ],
    "cs:fix": [
      "@php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --allow-risky=yes"
    ],
    "test": [
      "@php vendor/bin/phpunit -c phpunit.xml.dist"
    ],
    "test:ci": [
      "@php vendor/bin/phpunit -c phpunit.xml.dist --colors=never"
    ],
    "check:platform": [
      "@composer check-platform-reqs"
    ],
    "check": [
      "@composer:validate",
      "@check:platform",
      "@lint",
      "@cs:check",
      "@stan",
      "@test"
    ]
  },
  "scripts-descriptions": {
    "lint": "Run PHP syntax lint over source files.",
    "smoke": "Run smoke checks for basic component wiring.",
    "autoload:dev": "Regenerate Composer autoload files for development.",
    "autoload:optimize": "Regenerate optimized Composer autoload files.",
    "autoload:prod": "Regenerate optimized authoritative classmap for production.",
    "composer:validate": "Validate composer.json in strict mode.",
    "stan": "Run PHPStan static analysis.",
    "stan:ci": "Run PHPStan static analysis with GitHub Actions output format.",
    "cs:check": "Check coding standards using PHP-CS-Fixer.",
    "cs:fix": "Fix coding standards using PHP-CS-Fixer.",
    "test": "Run PHPUnit tests.",
    "test:ci": "Run PHPUnit tests without colors for CI output.",
    "check:platform": "Check installed platform requirements.",
    "check": "Run Composer validation, platform checks, syntax lint, coding standards, static analysis and PHPUnit tests."
  },
  "support": {
    "email": "honzamudrak@gmail.com",
    "source": "https://lemonadeframework.cz/"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
